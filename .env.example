# Copy this file to .env and adjust as needed.

# --- SigenStor Modbus TCP ---
MODBUS_HOST=192.168.68.56
MODBUS_PORT=502
# 247 is Sigenergy's fixed plant-level unit/slave id
PLANT_SLAVE_ID=247
# The hybrid inverter's own slave id, for PV-string-level detail. 1 is typical
# for a single-inverter install - confirm in the SigenStor app if unsure.
INVERTER_SLAVE_ID=1

# Poll rate tiers, in seconds - see collector/collector.py for which register
# is in which tier. FAST is for live power-flow numbers; MEDIUM for state that
# changes occasionally (mode, alarms); SLOW for slow-moving energy counters.
FAST_POLL_SECONDS=5
MEDIUM_POLL_SECONDS=30
SLOW_POLL_SECONDS=300
POLL_INTERVAL_SECONDS=5

# --- InfluxDB ---
# These are used to auto-provision InfluxDB on first start (docker-entrypoint init).
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-please
INFLUXDB_ORG=home
INFLUXDB_BUCKET=sigenstor
# Any string works as a fixed admin token - it gets created automatically on first
# start and reused by both the collector and Grafana. Change this before first run.
INFLUXDB_TOKEN=change-me-to-a-long-random-string

# --- Weather (Open-Meteo, no API key needed) ---
# Site coordinates, for pulling the right local forecast.
WEATHER_LATITUDE=50.62276
WEATHER_LONGITUDE=-4.74387
# How far back/forward each poll fetches. Open-Meteo's forecast endpoint caps
# these at 92 and 16 respectively - past_days re-fetches recent history each
# poll (refining toward reanalysis as it recedes into the past), forecast_days
# is the forward look-ahead.
WEATHER_PAST_DAYS=92
WEATHER_FORECAST_DAYS=16
WEATHER_POLL_SECONDS=3600

# --- Variheat MVHR (Calorex Variheat AW600, Modbus TCP) ---
# Note: unit/slave id is fixed at 255 (empirically determined, not the "Slave
# Address" shown in the PLC's BMS settings menu - that's for its RS485 port).
# See variheat-collector/variheat_collector.py for details.
VARIHEAT_MODBUS_HOST=192.168.68.66
VARIHEAT_MODBUS_PORT=502
# FAST is for live probe readings and run-state booleans (the closest thing
# to a power signal this register map has); MEDIUM is for setpoints and
# alarms/faults, which change rarely.
VARIHEAT_FAST_POLL_SECONDS=5
VARIHEAT_MEDIUM_POLL_SECONDS=30

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
