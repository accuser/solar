# Copy to /etc/variheat-control/control.env, then:
#   sudo chown variheat:variheat /etc/variheat-control/control.env
#   sudo chmod 600 /etc/variheat-control/control.env
#
# DO NOT set VARIHEAT_CONTROL_DRY_RUN=false (or fill in the two VALUE vars
# below) until you've confirmed the 0/1/2 mapping for register 16950 against
# the live unit - see the README's "Occupancy control bridge" section and
# variheat-control/probe_occupancy.py. Enabling this unit at all is safe
# before that, as long as it stays in dry-run mode.

MQTT_HOST=192.168.68.78
MQTT_PORT=1883
VARIHEAT_OCCUPIED_TOPICS=pool/control/occupied,fluvo/control/active

VARIHEAT_MODBUS_HOST=192.168.68.66
VARIHEAT_MODBUS_PORT=502

VARIHEAT_CONTROL_DRY_RUN=true
VARIHEAT_OCCUPIED_VALUE=
VARIHEAT_UNOCCUPIED_VALUE=
