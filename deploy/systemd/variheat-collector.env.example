# Copy to /etc/variheat-collector/collector.env, then:
#   sudo chown variheat:variheat /etc/variheat-collector/collector.env
#   sudo chmod 600 /etc/variheat-collector/collector.env
#
# Unlike the Docker Compose setup, INFLUXDB_URL can't rely on Docker's internal
# DNS ("http://influxdb:8086") - point it at wherever InfluxDB actually is
# reachable from this host (localhost if InfluxDB's Docker container still
# publishes 8086 on this same machine; a LAN IP if it's elsewhere).

VARIHEAT_MODBUS_HOST=192.168.68.66
VARIHEAT_MODBUS_PORT=502
VARIHEAT_FAST_POLL_SECONDS=5
VARIHEAT_MEDIUM_POLL_SECONDS=30

# Optional - republishes readings to the variheat/* MQTT topics Node-RED's
# dashboard consumes (see README's "Node-RED MQTT bridge" section). Leave
# both unset/blank to disable.
MQTT_HOST=
MQTT_PORT=1883

INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=home
INFLUXDB_BUCKET=sigenstor
