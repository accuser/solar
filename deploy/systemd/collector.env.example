# Copy to /etc/sigenstor-collector/collector.env, then:
#   sudo chown sigenstor:sigenstor /etc/sigenstor-collector/collector.env
#   sudo chmod 600 /etc/sigenstor-collector/collector.env
#
# Unlike the Docker Compose setup, INFLUXDB_URL can't rely on Docker's internal
# DNS ("http://influxdb:8086") - point it at wherever InfluxDB actually is
# reachable from this host (localhost if InfluxDB's Docker container still
# publishes 8086 on this same machine; a LAN IP if it's elsewhere).

MODBUS_HOST=192.168.68.56
MODBUS_PORT=502
PLANT_SLAVE_ID=247
INVERTER_SLAVE_ID=1
FAST_POLL_SECONDS=5
MEDIUM_POLL_SECONDS=30
SLOW_POLL_SECONDS=300

INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=home
INFLUXDB_BUCKET=sigenstor
